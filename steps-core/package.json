{
  "name": "steps-to-specs",
  "version": "0.2.0",
  "description": "Plain-text steps -> IR -> Playwright spec, driven by the consuming repo's steps.config.js. Ships the steps-to-spec Claude skill.",
  "keywords": ["playwright", "test-generation", "claude-code", "claude-skill", "e2e"],
  "main": "index.js",
  "type": "commonjs",
  "bin": {
    "steps-to-specs": "cli/install-skill.js",
    "steps-gen": "cli/gen.js",
    "steps-probe": "cli/probe.js",
    "steps-ids": "cli/ids.js",
    "steps-migrate": "cli/migrate.js"
  },
  "files": [
    "*.js",
    "cli",
    "runtime",
    "skill",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Awesomer9561/Automation.Skills.git",
    "directory": "steps-core"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/",
    "prepack": "node scripts/sync-skill.js"
  }
}
